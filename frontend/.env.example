# Base URL of the ANCP backend API (public / client-safe).
# Local development:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Production example:
# NEXT_PUBLIC_API_BASE_URL=https://api.your-domain.com/api/v1

# Supabase project URL and publishable (client-safe) key.
# The publishable/anon key is designed to be exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# NEVER put SUPABASE_SERVICE_ROLE_KEY, database credentials, AI API keys, or any
# backend secret in the frontend. Only NEXT_PUBLIC_* values reach the browser.
