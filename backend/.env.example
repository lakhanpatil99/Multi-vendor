# ============================================================
# ANCP Backend — environment template (Phase 2)
# Copy to `.env` and fill in. NEVER commit the real .env.
# The backend runs fully OFFLINE with the defaults below
# (SQLite + local filesystem storage + dev auth). Point the
# Supabase/Postgres values at a real project to go managed.
# ============================================================

# ── App ─────────────────────────────────────────────────────────
APP_ENV=development                 # development | test | production
APP_NAME=ANCP Backend
LOG_LEVEL=INFO
# Comma-separated allowed CORS origins. NEVER use "*" in production.
CORS_ORIGINS=http://localhost:3000

# ── Database ────────────────────────────────────────────────────
# Offline default (leave blank to use ./ancp.db SQLite):
DATABASE_URL=
# Supabase PostgreSQL example (session pooler):
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── Supabase ────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret used by Supabase Auth to sign tokens (Project Settings → API → JWT Secret).
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# ── Storage ─────────────────────────────────────────────────────
# local  → ./var/storage (offline default)
# supabase → Supabase Storage buckets (requires SUPABASE_* above)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./var/storage
STORAGE_BUCKET_CONFIGS=ancp-configurations
STORAGE_BUCKET_REPORTS=ancp-reports

# ── Auth ────────────────────────────────────────────────────────
# dev      → accepts a static bearer token (DEV_API_TOKEN) mapped to a seeded user
# supabase → validates Supabase JWT (HS256 via SUPABASE_JWT_SECRET)
AUTH_MODE=dev
DEV_API_TOKEN=dev-local-token
# Seeded default organization + user used in dev auth mode:
DEV_ORG_SLUG=acme-netops
DEV_USER_EMAIL=analyst@acme.example
DEV_USER_ROLE=ADMIN

# ── AI provider abstraction ─────────────────────────────────────
# local  → deterministic heuristic provider (no external calls, default)
# openai / gemini → wired later without touching business logic
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=
AI_EMBEDDING_MODEL=

# ── Background jobs ─────────────────────────────────────────────
# inline → run pipeline synchronously in-process (offline default)
# celery → dispatch to workers via Redis (Phase 4+)
JOB_BACKEND=inline
REDIS_URL=

# ── Uploads ─────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=1048576            # 1 MiB
ALLOWED_CONFIG_EXTENSIONS=.txt,.cfg,.conf

# ── Rate limiting (per client, per window) ──────────────────────
RATE_LIMIT_DEFAULT=120/60           # requests/seconds
RATE_LIMIT_UPLOAD=10/60
RATE_LIMIT_ANALYZE=20/60
RATE_LIMIT_REPORT=10/60
